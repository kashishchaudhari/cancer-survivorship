            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Cohort = text, Strategy = text, Bin = text, Predicted = number, Observed = number, GroupPatients = Int64.Type], {\n{\"Brain\", \"Patient holdout\", \"1\", 0.5923595896330315, 0.6984126984126984, 63},\n{\"Brain\", \"Patient holdout\", \"2\", 0.6388002902565314, 0.6440677966101694, 59},\n{\"Brain\", \"Patient holdout\", \"3\", 0.6690346848877097, 0.6440677966101694, 59},\n{\"Brain\", \"Patient holdout\", \"4\", 0.6961684152637165, 0.6949152542372882, 59},\n{\"Brain\", \"Patient holdout\", \"5\", 0.734615895978451, 0.6666666666666666, 60},\n{\"Brain\", \"Temporal sensitivity\", \"1\", 0.6037094575550884, 0.6883116883116883, 77},\n{\"Brain\", \"Temporal sensitivity\", \"2\", 0.6451740283223087, 0.5714285714285714, 77},\n{\"Brain\", \"Temporal sensitivity\", \"3\", 0.6770837866681203, 0.75, 76},\n{\"Brain\", \"Temporal sensitivity\", \"4\", 0.7034377902439298, 0.618421052631579, 76},\n{\"Brain\", \"Temporal sensitivity\", \"5\", 0.7456489070090779, 0.6578947368421053, 76},\n{\"Breast\", \"Patient holdout\", \"1\", 0.6197537309844992, 0.6615384615384615, 65},\n{\"Breast\", \"Patient holdout\", \"2\", 0.6513498554180212, 0.7777777777777778, 54},\n{\"Breast\", \"Patient holdout\", \"3\", 0.6709862121915942, 0.6229508196721312, 61},\n{\"Breast\", \"Patient holdout\", \"4\", 0.6849311871556425, 0.6557377049180327, 61},\n{\"Breast\", \"Patient holdout\", \"5\", 0.7187630902867516, 0.6491228070175439, 57},\n{\"Breast\", \"Temporal sensitivity\", \"1\", 0.6136217698664678, 0.7333333333333333, 75},\n{\"Breast\", \"Temporal sensitivity\", \"2\", 0.6487020631158036, 0.7333333333333333, 75},\n{\"Breast\", \"Temporal sensitivity\", \"3\", 0.6721110934903685, 0.5064935064935064, 77},\n{\"Breast\", \"Temporal sensitivity\", \"4\", 0.6936248721476072, 0.6486486486486487, 74},\n{\"Breast\", \"Temporal sensitivity\", \"5\", 0.7288549693370193, 0.726027397260274, 73},\n{\"Prostate\", \"Patient holdout\", \"1\", 0.6473080471800418, 0.630769230