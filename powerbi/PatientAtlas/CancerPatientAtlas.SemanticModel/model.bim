        "partitions": [
          {
            "name": "SurgeryEvaluation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Cohort = text, Strategy = text, TestPatients = Int64.Type, SurgeryRecorded = Int64.Type, Prevalence = number, AveragePrecision = number, RocAuc = number, Brier = number, BaselineBrier = number], {\n{\"Brain\", \"Patient holdout\", 300, 201, 0.67, 0.6683219588007816, 0.48474797728529073, 0.225308678978008, 0.22110121810718},\n{\"Brain\", \"Temporal sensitivity\", 382, 251, 0.6570680628272252, 0.6430255905684485, 0.4911194914996503, 0.2295143563717545, 0.22559146420459197},\n{\"Breast\", \"Patient holdout\", 298, 200, 0.6711409395973155, 0.6869824385026086, 0.4928571428571429, 0.221961458614665, 0.22071460230955348},\n{\"Breast\", \"Temporal sensitivity\", 374, 250, 0.6684491978609626, 0.6785198745847739, 0.4877741935483871, 0.22433870820481958, 0.22162713565277817},\n{\"Prostate\", \"Patient holdout\", 301, 202, 0.6710963455149501, 0.6631808662212795, 0.4953745374537454, 0.22096540110786572, 0.22072724252491696},\n{\"Prostate\", \"Temporal sensitivity\", 346, 232, 0.6705202312138728, 0.6898969299248999, 0.5182055353901995, 0.22069988477144106, 0.22092300312854327},\n{\"Skin\", \"Patient holdout\", 300, 200, 0.6666666666666666, 0.6849889145850363, 0.512175, 0.22218593301433232, 0.22222229951147782},\n{\"Skin\", \"Temporal sensitivity\", 375, 237, 0.632, 0.6284719170296037, 0.4965602641717117, 0.23556807328529278, 0.2346861108648573},\n{\"Liver\", \"Patient holdout\", 305, 200, 0.6557377049180327, 0.6598923528754783, 0.4957857142857143, 0.2265850668620648, 0.22574754859353008},\n{\"Liver\", \"Temporal sensitivity\", 403, 266, 0.6600496277915633, 0.6578273054810331, 0.5242302837385434, 0.22423295584893418, 0.2244036050295084}\n})"
            }
          }
        ]
      },
