{
  "name": "CancerPatientAtlas",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Cohorts",
        "columns": [
          {
            "name": "Cohort",
            "dataType": "string",
            "sourceColumn": "Cohort",
            "summarizeBy": "none",
            "sortByColumn": "SortOrder"
          },
          {
            "name": "SortOrder",
            "dataType": "int64",
            "sourceColumn": "SortOrder",
            "summarizeBy": "none"
          },
          {
            "name": "SourceRecords",
            "dataType": "int64",
            "sourceColumn": "SourceRecords",
            "summarizeBy": "none"
          },
          {
            "name": "IndexPatients",
            "dataType": "int64",
            "sourceColumn": "IndexPatients",
            "summarizeBy": "none"
          },
          {
            "name": "StageAvailability",
            "dataType": "string",
            "sourceColumn": "StageAvailability",
            "summarizeBy": "none"
          },
          {
            "name": "MedianTimingDays",
            "dataType": "double",
            "sourceColumn": "MedianTimingDays",
            "summarizeBy": "none"
          },
          {
            "name": "TimingUnknown",
            "dataType": "int64",
            "sourceColumn": "TimingUnknown",
            "summarizeBy": "none"
          },
          {
            "name": "TimingTopCoded",
            "dataType": "int64",
            "sourceColumn": "TimingTopCoded",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Cohorts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Cohort = text, SortOrder = Int64.Type, SourceRecords = Int64.Type, IndexPatients = Int64.Type, StageAvailability = text, MedianTimingDays = number, TimingUnknown = Int64.Type, TimingTopCoded = Int64.Type], {\n{\"Brain\", 1, 2000, 2000, \"Unavailable in source\", 45.0, 254, 273},\n{\"Breast\", 2, 2000, 2000, \"Unavailable in source\", 45.0, 270, 228},\n{\"Prostate\", 3, 2000, 2000, \"Unavailable in source\", 21.0, 264, 285},\n{\"Skin\", 4, 2000, 2000, \"Unavailable in source\", 21.0, 246, 245},\n{\"Liver\", 5, 2000, 2000, \"Available: source summary stage\", 21.0, 242, 247}\n})"
            }
          }
        ],
        "measures": [
          {
            "name": "Surgery test patients",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[TestPatients]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Surgery recorded",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[SurgeryRecorded]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Surgery prevalence",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[Prevalence]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.0%"
          },
          {
            "name": "Surgery average precision",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[AveragePrecision]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Surgery ROC AUC",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[RocAuc]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Surgery Brier",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[Brier]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Surgery baseline Brier",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryEvaluation[BaselineBrier]), SurgeryEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Predicted surgery probability",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryCalibration[Predicted]), SurgeryCalibration[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.0%"
          },
          {
            "name": "Observed surgery fraction",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryCalibration[Observed]), SurgeryCalibration[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.0%"
          },
          {
            "name": "Calibration group patients",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurgeryCalibration[GroupPatients]), SurgeryCalibration[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Survival C-index",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurvivalEvaluation[CIndex]), SurvivalEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Cox IPCW Brier",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurvivalEvaluation[IpcwBrier]), SurvivalEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "KM baseline Brier",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurvivalEvaluation[BaselineBrier]), SurvivalEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "0.000"
          },
          {
            "name": "Survival test patients",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurvivalEvaluation[TestPatients]), SurvivalEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Patients at risk",
            "expression": "VAR ChosenStrategy = COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")\nRETURN IF(HASONEVALUE(Cohorts[Cohort]), CALCULATE(SELECTEDVALUE(SurvivalEvaluation[AtRisk]), SurvivalEvaluation[Strategy] = ChosenStrategy), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Index patients",
            "expression": "IF(HASONEVALUE(Cohorts[Cohort]), SELECTEDVALUE(Cohorts[IndexPatients]), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Source records",
            "expression": "IF(HASONEVALUE(Cohorts[Cohort]), SELECTEDVALUE(Cohorts[SourceRecords]), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Median timing days",
            "expression": "IF(HASONEVALUE(Cohorts[Cohort]), SELECTEDVALUE(Cohorts[MedianTimingDays]), BLANK())",
            "formatString": "0.0"
          },
          {
            "name": "Stage availability",
            "expression": "IF(HASONEVALUE(Cohorts[Cohort]), IF(SELECTEDVALUE(Cohorts[StageAvailability]) = \"Available: source summary stage\", \"Available\", \"Unavailable\"), BLANK())",
            "formatString": ""
          },
          {
            "name": "Recorded treatment patients",
            "expression": "IF(HASONEVALUE(Cohorts[Cohort]) && HASONEVALUE(Modalities[Modality]), SUM(TreatmentPatterns[PatientCount]), BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "AP lift over prevalence",
            "expression": "DIVIDE([Surgery average precision], [Surgery prevalence])",
            "formatString": "0.00x"
          },
          {
            "name": "Selected study",
            "expression": "SELECTEDVALUE(Cohorts[Cohort], \"Choose one cancer\")"
          },
          {
            "name": "Selected evaluation",
            "expression": "COALESCE(SELECTEDVALUE(Strategies[Strategy]), \"Patient holdout\")"
          },
          {
            "name": "Data classification",
            "expression": "\"SYNTHETIC DEMONSTRATION - invented values\""
          }
        ]
      },
      {
        "name": "Strategies",
        "columns": [
          {
            "name": "Strategy",
            "dataType": "string",
            "sourceColumn": "Strategy",
            "summarizeBy": "none",
            "sortByColumn": "SortOrder"
          },
          {
            "name": "SortOrder",
            "dataType": "int64",
            "sourceColumn": "SortOrder",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Strategies",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Strategy = text, SortOrder = Int64.Type], {\n{\"Patient holdout\", 1},\n{\"Temporal sensitivity\", 2}\n})"
            }
          }
        ]
      },
      {
        "name": "Horizons",
        "columns": [
          {
            "name": "Months",
            "dataType": "int64",
            "sourceColumn": "Months",
            "summarizeBy": "none"
          },
          {
            "name": "Horizon",
            "dataType": "string",
            "sourceColumn": "Horizon",
            "summarizeBy": "none",
            "sortByColumn": "Months"
          }
        ],
        "partitions": [
          {
            "name": "Horizons",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Months = Int64.Type, Horizon = text], {\n{12, \"1 year\"},\n{36, \"3 years\"},\n{60, \"5 years\"}\n})"
            }
          }
        ]
      },
      {
        "name": "Modalities",
        "columns": [
          {
            "name": "Modality",
            "dataType": "string",
            "sourceColumn": "Modality",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Modalities",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Modality = text], {\n{\"Surgery\"},\n{\"Radiation\"},\n{\"Chemotherapy\"}\n})"
            }
          }
        ]
      },
      {
        "name": "SurgeryEvaluation",
        "columns": [
          {
            "name": "Cohort",
            "dataType": "string",
